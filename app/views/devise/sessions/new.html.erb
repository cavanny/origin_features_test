<div class="auth-wrapper">

  <header class="auth-header">
    <%= image_tag "origin-logo.png", alt: "Origin Inventory", width: 300, heigh:300 %>
    <% if notice.present? %><p class="flash notice"><%= notice %></p><% end %>
    <% if alert.present? %><p class="flash alert"><%= alert %></p><% end %>
  </header>

  <main class="auth-content">
    <div class="card-flat auth-card">
      <h2 class="card-title">Sign In</h2>

      <%= form_with model: resource, as: resource_name, url: session_path(resource_name) do |form| %>
        <div class="form-group">
          <%= form.label :email, class: "form-label" %>
          <%= form.text_field :email, class: "form-input" %>
        </div>

        <div class="form-group">
          <%= form.label :password, class: "form-label" %>
          <%= form.password_field :password, class: "form-input" %>
        </div>

        <%= form.submit "Log In", class: "btn-primary" %>
      <% end %>
    </div>
  </main>

</div>
