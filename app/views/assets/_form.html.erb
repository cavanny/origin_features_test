<%= form_with model: asset do |form| %>
  <% if form.object.errors.any? %>
    <div class="form-errors">
      <p class="form-errors__title">
        <%= pluralize(form.object.errors.count, "error") %> prevented this asset from being saved:
      </p>
      <ul class="form-errors__list">
        <% form.object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="form-group form-group--full">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: "form-input", placeholder: "Dell Pro Premium 14" %>
    </div>

    <div class="form-group">
      <%= form.label :serial, "Serial number", class: "form-label" %>
      <%= form.text_field :serial, class: "form-input", placeholder: "123ABC" %>
    </div>

    <div class="form-group">
      <%= form.label :category_id, "Category", class: "form-label" %>
      <%= form.collection_select :category_id, categories, :id, :name,
            { include_blank: "— None —" }, { class: "form-input" } %>
    </div>

    <div class="form-group">
      <%= form.label :status_id, "Status", class: "form-label" %>
      <%= form.collection_select :status_id, statuses, :id, :name,
            { include_blank: "— None —" }, { class: "form-input" } %>
      <span class="form-hint">
        Manage these lists in <%= link_to "Configuration", settings_path %>.
      </span>
    </div>

    <div class="form-group">
      <%= form.label :purchaseCost, "Purchase cost", class: "form-label" %>
      <%= form.number_field :purchaseCost, step: 0.01, class: "form-input", placeholder: "0.00" %>
      <span class="form-hint">Assign this asset to someone from its detail page.</span>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit(asset.new_record? ? "Create asset" : "Save changes", class: "btn-primary") %>
    <%= link_to "Cancel", root_path, class: "btn-secondary" %>
  </div>
<% end %>
